      "backgroundColor": "#0B0B0B"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.medonex.app",
      "userInterfaceStyle": "automatic"
    },
    "android": {
      "package": "com.medonex.app",
      "edgeToEdgeEnabled": true,
      "userInterfaceStyle": "automatic",
      "permissions": [
        "NOTIFICATIONS"
      ]
